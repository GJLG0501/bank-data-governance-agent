# Valores ficticios, exclusivamente para desarrollo local.
# Copia este archivo a .env y cambia la contrasena antes del primer inicio.
POSTGRES_USER=bank_governance_dev
POSTGRES_PASSWORD=ejemplo_local_cambiar_antes_de_usar
POSTGRES_DB=bank_governance_synthetic_dev

# Embeddings locales del corpus. No requieren claves de API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-large:latest

# Agente conversacional local; no cambia el modelo de embeddings.
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_CHAT_TIMEOUT=180

# Proveedor generativo independiente del corpus y de embeddings.
# Sin estas opciones se conserva Ollama y el catálogo legado por compatibilidad.
BANK_LLM_PROVIDER=ollama
# BANK_LLM_MODEL=llama3.1:latest
BANK_LLM_CONTEXT=8192
BANK_LLM_OUTPUT_TOKENS=384
BANK_LLM_TEMPERATURE=0
BANK_LLM_TOOLS=true
BANK_LLM_STRUCTURED_OUTPUT=true
BANK_ALLOW_CLOUD=false
# Gemini opcional: uv sync --extra cloud --locked --inexact
# Seleccionar BANK_LLM_PROVIDER=gemini y BANK_LLM_MODEL explícitamente.
# Exportar GOOGLE_API_KEY o GEMINI_API_KEY en el entorno; nunca versionar su valor.
